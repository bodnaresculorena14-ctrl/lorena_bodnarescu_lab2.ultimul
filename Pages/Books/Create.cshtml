using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;
using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.RazorPages;
using Microsoft.AspNetCore.Mvc.Rendering;
using lorena_bodnarescu_lab2.ultimul.Data;
using lorena_bodnarescu_lab2.ultimul.Models;

namespace lorena_bodnarescu_lab2.ultimul.Pages.Books
{
    public class CreateModel : BookCategoriesPageModelcs
    {
        private readonly lorena_bodnarescu_lab2ultimulContext _context;

        public CreateModel(lorena_bodnarescu_lab2ultimulContext context)
        {
            _context = context;
        }

        [BindProperty]
        public Book Book { get; set; } = default!;

        public IActionResult OnGet()
        {
            // încărcăm autorii
            var authorList = _context.Author.Select(a => new
            {
                a.ID,
                FullName = a.LastName + " " + a.FirstName
            });

            ViewData["AuthorID"] = new SelectList(authorList, "ID", "FullName");

            // încărcăm publisherii
            ViewData["PublisherID"] = new SelectList(_context.Publisher, "ID", "PublisherName");

            // populăm lista de categorii (checkbox-uri)
            var book = new Book();
            book.BookCategories = new List<BookCategory>
    ();
    PopulateAssignedCategoryData(_context, book);

    return Page();
    }

    public async Task<IActionResult>
        OnPostAsync(string[] selectedCategories)
        {
        var newBook = new Book();

        if (selectedCategories != null)
        {
        newBook.BookCategories = new List<BookCategory>
            ();
            foreach (var cat in selectedCategories)
            {
            var catToAdd = new BookCategory { CategoryID = int.Parse(cat) };
            newBook.BookCategories.Add(catToAdd);
            }
            }

            if (await TryUpdateModelAsync<Book>
                (
                newBook,
                "Book",
                i => i.Title, i => i.AuthorID,
                i => i.PublisherID, i => i.Price, i => i.PublishingDate))
                {
                _context.Book.Add(newBook);
                await _context.SaveChangesAsync();
                return RedirectToPage("./Index");
                }

                // dacă formularul e invalid, refacem listele
                PopulateAssignedCategoryData(_context, newBook);
                ViewData["AuthorID"] = new SelectList(_context.Author, "ID", "LastName");
                ViewData["PublisherID"] = new SelectList(_context.Publisher, "ID", "PublisherName");

                return Page();
                }
                }
                }
               